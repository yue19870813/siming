{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siming.dev/schemas/runtime-locale-chunk.schema.json",
  "title": "Siming Runtime Locale Chunk",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locale", "texts"],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "locale": {
      "$ref": "runtime.schema.json#/$defs/locale"
    },
    "texts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/richText"
          }
        ]
      }
    }
  },
  "$defs": {
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runs"],
      "properties": {
        "version": {
          "const": 1
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string"
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bold": {
                    "type": "boolean"
                  },
                  "italic": {
                    "type": "boolean"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "texts": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  ]
}
