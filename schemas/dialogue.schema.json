{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://siming.dev/schemas/dialogue.schema.json",
  "title": "Siming Dialogue Source Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "key",
    "name",
    "entryNodeId",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [1, 2]
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "key": {
      "$ref": "#/$defs/key"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/key"
      }
    },
    "entryNodeId": {
      "$ref": "#/$defs/uuid"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
      }
    },
    "hostEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "payload"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "advancePolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {
              "const": "manual"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "delayMs"],
          "properties": {
            "mode": {
              "const": "auto"
            },
            "delayMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "conditionComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variable", "operator", "value"],
      "properties": {
        "variable": {
          "$ref": "#/$defs/key"
        },
        "operator": {
          "enum": ["==", "!=", ">", ">=", "<", "<="]
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "conditionExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/conditionComparison"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/conditionExpression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": {
              "$ref": "#/$defs/conditionExpression"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "type", "position", "data"],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "$ref": "#/$defs/key"
        },
        "type": {
          "enum": ["start", "dialogue", "choice", "condition", "event", "end"]
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "data": {
          "type": "object",
          "properties": {
            "speakerId": {
              "type": "string"
            },
            "text": {
              "$ref": "#/$defs/localizedBody"
            },
            "condition": {
              "$ref": "#/$defs/conditionExpression"
            },
            "hostEvents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/hostEvent"
              }
            },
            "advancePolicy": {
              "$ref": "#/$defs/advancePolicy"
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/key"
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceNodeId",
        "sourcePort",
        "targetNodeId",
        "targetPort"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceNodeId": {
          "$ref": "#/$defs/uuid"
        },
        "sourcePort": {
          "type": "string",
          "minLength": 1
        },
        "targetNodeId": {
          "$ref": "#/$defs/uuid"
        },
        "targetPort": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "richText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "runs"],
      "properties": {
        "version": {
          "const": 1
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": {
                "type": "string"
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "bold": {
                    "type": "boolean"
                  },
                  "italic": {
                    "type": "boolean"
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "localizedBody": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/richText"
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "properties": {
                "data": {
                  "properties": {
                    "text": {
                      "$ref": "#/$defs/localizedText"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  ]
}
